NODE_ENV=development

# Local dashboard port. Ports 3000 and 3001 may already be in use.
DASHBOARD_PORT=3002

# Express service ports
API_PORT=4100
DEMO_APP_PORT=4101
DEMO_APP_RELEASE=healthy
MONGODB_PORT=27017
MONITOR_PORT=4102
TRIAGE_PORT=4103
EXECUTOR_PORT=4104
TRIAGE_TIMEOUT_MS=60000

# MongoDB URI for local development; replace with a hosted URI if preferred.
MONGODB_URI=mongodb://127.0.0.1:27017/oncall_demo?directConnection=true

# Monitored application and monitoring policy
MONITORED_APP_ID=demo-app
MONITORED_APP_NAME=Demo application
MONITORED_APP_URL=http://127.0.0.1:4101
MONITOR_INTERVAL_MS=30000
MONITOR_TIMEOUT_MS=5000
MONITOR_FAILURE_THRESHOLD=3
MONITOR_RECOVERY_THRESHOLD=2
# Local development value only. Use a unique secret outside your machine.
MONITOR_INGEST_TOKEN=local-dev-monitor-token-change-before-sharing-0001

# Local-only teammate reporting credentials. Replace the example token and identity.
# Add one token-to-identity entry per teammate. Never expose this variable to the browser.
TEAM_REPORTER_TOKENS='{"local-team-token-change-before-sharing-0001":{"id":"local-owner","name":"Local teammate"}}'

# Internal API-to-triage authentication. Replace before sharing or deploying.
TRIAGE_SERVICE_TOKEN=local-triage-service-token-change-before-sharing-0001

# OpenCode server. Its configured default model/provider is used (for example, Switch.ai).
# Start `opencode serve` locally; credentials remain in OpenCode, not this application.
OPENCODE_URL=http://127.0.0.1:4096
# Optional; set a password only when the OpenCode server uses HTTP Basic authentication.
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=

# Server-side service URLs for local development
API_URL=http://127.0.0.1:4100
DEMO_APP_URL=http://127.0.0.1:4101
MONITOR_URL=http://127.0.0.1:4102
TRIAGE_URL=http://127.0.0.1:4103
EXECUTOR_URL=http://127.0.0.1:4104
HEALTH_CHECK_TIMEOUT_MS=1500
